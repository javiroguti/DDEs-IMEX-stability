         RowBox[{"b1s", "*", 
          RowBox[{"B", ".", 
           RowBox[{"z", "[", 
            RowBox[{"tn", "-", 
             RowBox[{"m", "*", "h"}]}], "]"}]}]}], "+", 
         RowBox[{"b0s", "*", 
          RowBox[{"B", ".", 
           RowBox[{"z", "[", 
            RowBox[{"tn", "-", 
             RowBox[{"m", "*", "h"}], "-", "h"}], "]"}]}]}]}], ")"}]}]}], 
     ")"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9570951169302273`*^9, 3.957095402608104*^9}, {
