Cell[CellGroupData[{
Cell["FKPP equation problem", "Title",
 CellChangeTimes->{{4.001307845465559*^9, 
  4.0013078517716713`*^9}},ExpressionUUID->"eebed95a-3a92-e843-8c64-\
d17d765c4d5b"],

Cell["Tratamos el problema z\[CloseCurlyQuote](t) = A z(t) + B z(t - \[Tau]) \
", "Text",
 CellChangeTimes->{{3.957092638716433*^9, 3.957092659157358*^9}, 
   3.957792998109894*^9, {3.9589636050262337`*^9, 
   3.958963634621647*^9}},ExpressionUUID->"60e56e11-bb76-b545-8f0d-\
843019fdad9c"],

Cell["\<\
Definimos el vector soluci\[OAcute]n z(t)=(z1(t),z2(t)), con
z1(t)=(z1_1(t),...,z1_n-1(t))^T;  z2(t)=(z2_1(t),...,z2_n-1(t))^T, y donde
zk,j^i=uk(ti,xj), zk,j(t)=uk(t,xj)
A={{a1T,0},{0,a2T}}; \
B=e^(l\[Pi]/2){{-Id,(l+\[Pi]^2/4)Id},{-(l+\[Pi]^2/4)Id,-Id}};  Id=Id_n-1
T=1/(\[CapitalDelta]x)^2*(Matriz Toeplitz[-2,1,1]_(n-1)(n-1))\
\>", "Text",
 CellChangeTimes->{{3.957092487203457*^9, 3.9570925429436455`*^9}, 
   3.957792962062729*^9, 3.95862112688306*^9, {3.958963644062313*^9, 
   3.9589638040534687`*^9}, {3.958965090125858*^9, 
   3.958965285131777*^9}},ExpressionUUID->"3e327547-cdaf-0045-862f-\
cf7f35c3cad3"],

